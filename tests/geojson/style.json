{
    "metadata":{
        "mgis-jsonstyle-spec": 0.1
    },
    "constants":{
        "@BLACK_COLOR":"#000000",
        "@RED_COLOR":"#ff0000",
        "@BLUE_COLOR":"#1500ff",
        "@BASE_WIDTH":3
    },
    "styles":[
        {
            "id":"someid",
            "condition": [
				"$PROPERTIES.sovereignt == 'Russia' ",
				"$GEOMETRY.type == $POLY or $GEOMETRY.type == $MPOLY"
			],
            "instruction":{
                "fill":"@RED_COLOR",
                "fill-opacity":0.5,
                "stroke":"@BLUE_COLOR",
                "stroke-opacity":0.5,
                "stroke-width":"@BASE_WIDTH",
                "dash-pattern":[5,2,5,2],
                "dash-offset":2,
                "cap":"flat"
            }
        }
    ]
}