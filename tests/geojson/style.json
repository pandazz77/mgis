{
    "metadata":{
        "mgis-jsonstyle-spec":"0.0.1"
    },
    "constants":{
        "@BLACK_COLOR":"#000000",
        "@RED_COLOR":"#ff0000",
        "@BASE_WIDTH":1
    },
    "styles":[
        {
            "id":"someid",
            "condition": [
				"$PROPERTIES.sovereignt == 'Russia' ",
				"$GEOMETRY.type == $POLY or $GEOMETRY.type == $MPOLY"
			],
            "instruction":{
                "fill":"@RED_COLOR",
                "stroke":"@BLACK_COLOR",
                "stroke-width":1
            }
        }
    ]
}