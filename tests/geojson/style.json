{
    "metadata":{
        "mgis-jsonstyle-spec":"0.0.1"
    },
    "constants":{
        "@BLACK_COLOR":"#000000",
        "@RED_COLOR":"#ff0000"
    },
    "styles":[
        {
            "id":"someid",
            "condition": [
				"$PROPERTIES.country == russia",
				"$GEOMETRY.type == $POLY"
			],
